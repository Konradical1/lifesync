# App (read by app.config.js and embedded in the build). The anon key is public by design.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: your own API deployment. Defaults to the production API in src/api/config.js.
EXPO_PUBLIC_API_URL=
# Optional: Google Sign-In (the button stays hidden until these are set, see DEPLOYMENT.md)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=

# API (Vercel environment variables, or .env.local for `vercel dev`). Never put these in the app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
OPENROUTER_API_KEY=your-openrouter-key
# Any long random string. Vercel Cron sends it to /api/notifications/cron.
CRON_SECRET=
# Optional model overrides for the food endpoints
FOOD_MODEL=
FOOD_FALLBACK_MODEL=
