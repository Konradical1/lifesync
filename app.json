{
  "expo": {
    "name": "LifeSync",
    "slug": "JournalX2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppLogo2.jpg",
    "scheme": "lifesync",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1117"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.konradfischer.lifesync",
      "buildNumber": "1",
      "icon": "./assets/AppLogo2.jpg",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "LifeSync uses Face ID to unlock the app and keep your journal private.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppLogo2.jpg",
        "backgroundColor": "#0D1117"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.konradfischer.lifesync"
    },
    "web": {
      "favicon": "./assets/AppLogoTS.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/AppLogo2.jpg",
          "color": "#0D1117"
        }
      ]
    ]
  }
}
